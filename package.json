{
  "name": "chart-parkour",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:browser": "node tests/browser.mjs",
    "check:service": "node tests/service.mjs",
    "check:gameplay": "node tests/gameplay.mjs",
    "build:wallet": "esbuild wallet/privy.js --bundle --minify --format=iife --target=es2020 --define:process.env.NODE_ENV='\"production\"' --define:global=globalThis --outfile=vendor/privy.js --log-level=warning"
  },
  "dependencies": {
    "@sparticuz/chromium": "^147.0.2",
    "ethers": "6.13.4",
    "playwright": "1.58.2",
    "playwright-core": "^1.58.2",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@privy-io/react-auth": "3.49.1",
    "esbuild": "0.24.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
